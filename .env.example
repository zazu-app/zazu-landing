# URL pública del sitio (sin barra final). Se usa para SEO: metadata, sitemap y robots.
NEXT_PUBLIC_SITE_URL=https://zazu.com.es

# Google Analytics 4. Sin este valor, GA4 no se carga.
# GA4 solo se activa además tras el consentimiento del usuario (banner de cookies).
NEXT_PUBLIC_GA_ID=

# Vercel Web Analytics es cookieless y se activa automáticamente al desplegar en Vercel.
